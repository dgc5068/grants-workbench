# Giscus comment system (https://giscus.app)
# 1. Make the repo public and enable GitHub Discussions on it
# 2. Install the Giscus app: https://github.com/apps/giscus
# 3. Copy the generated values below into .env.local

NEXT_PUBLIC_GISCUS_REPO="your-username/your-repo"
NEXT_PUBLIC_GISCUS_REPO_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY="Announcements"
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""

# Canonical site URL used for sitemap, RSS, and OpenGraph metadata
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
